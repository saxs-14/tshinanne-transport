rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isActiveUser() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwner());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isOwner());
      allow delete: if isOwner();
    }

    match /trucks/{truckId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isOwner();
    }

    match /customers/{customerId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isOwner();
    }

    match /deliveries/{deliveryId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if isOwner();
    }

    match /expenses/{expenseId} {
      allow read: if isOwner();
      allow create: if isActiveUser();
      allow update, delete: if isOwner();
    }

    match /fuelRecords/{fuelId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isOwner();
    }

    match /maintenanceRecords/{recordId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser();
      allow update, delete: if isOwner();
    }
  }
}