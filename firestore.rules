rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function isActiveUser() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isOwner() || (isActiveUser() && resource.data.role == 'driver'));
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isOwner());
      allow delete: if isOwner();
    }

    match /trucks/{truckId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isOwner();
    }

    match /customers/{customerId} {
      allow read, create, update: if isActiveUser();
      allow delete: if isOwner();
    }

    match /deliveries/{deliveryId} {
      allow read: if isActiveUser() && (isOwner() || resource.data.driverId == request.auth.uid);
      allow create: if isActiveUser() && (isOwner() || request.resource.data.driverId == request.auth.uid);
      allow update: if isActiveUser() && (isOwner() || resource.data.driverId == request.auth.uid);
      allow delete: if isOwner();
    }

    match /expenses/{expenseId} {
      allow read: if isOwner();
      allow create: if isActiveUser();
      allow update, delete: if isOwner();
    }

    match /fuelRecords/{fuelId} {
      allow read: if isActiveUser() && (isOwner() || resource.data.createdBy == request.auth.uid || resource.data.truckId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedTruckId);
      allow create: if isActiveUser() && (isOwner() || request.resource.data.truckId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedTruckId);
      allow update, delete: if isOwner();
    }

    match /maintenanceRecords/{recordId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && (isOwner() || request.resource.data.truckId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedTruckId);
      allow update, delete: if isOwner();
    }
    match /inspections/{inspectionId} {
      allow read: if isActiveUser() && (isOwner() || resource.data.driverId == request.auth.uid);
      allow create: if isActiveUser() && request.resource.data.driverId == request.auth.uid;
      allow update: if isOwner() || (isActiveUser() && resource.data.driverId == request.auth.uid);
      allow delete: if isOwner();
    }

  }
}
