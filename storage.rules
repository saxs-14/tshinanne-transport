rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /deliveryProof/{deliveryId}/{fileName} {
      function isActiveOwner() {
        return request.auth != null
          && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'owner'
          && get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
      }

      function isAssignedDriver() {
        return request.auth != null
          && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'driver'
          && get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true
          && get(/databases/(default)/documents/deliveries/$(deliveryId)).data.driverId == request.auth.uid;
      }

      function canAccessDelivery() {
        return isActiveOwner() || isAssignedDriver();
      }

      allow read: if canAccessDelivery();
      allow write: if canAccessDelivery()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}